<div class="se-controls" data-se-controls hidden>
    <button type="button" data-se-prev aria-label="Voltar em {{ carousel_title | escape }}" aria-controls="{{ carousel_id }}-track"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7"/></svg></button>
    <div class="se-dots" data-se-dots aria-label="Selecionar item de {{ carousel_title | escape }}"></div>
    <span class="se-count" data-se-count aria-live="polite" aria-atomic="true"></span>
    <button type="button" data-se-next aria-label="Avançar em {{ carousel_title | escape }}" aria-controls="{{ carousel_id }}-track"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 5 7 7-7 7"/></svg></button>
</div>
